# Copia questo file in ".env.ftp" (senza ".example") e riempilo con le
# credenziali reali dello spazio FTP Aruba. ".env.ftp" contiene una password
# in chiaro: non condividerlo, non incollarlo in chat/issue, e se in futuro
# questo repo diventa un repository git aggiungilo a .gitignore.

FTP_HOST=ftp.gruppopugliagrotte.it
FTP_USER=
FTP_PASS=
# Cartella remota di destinazione (di solito la webroot del piano Aruba,
# spesso "/" oppure "/httpdocs" a seconda del tipo di hosting):
FTP_REMOTE_DIR=/
# "ftp" (plain) o "ftps" (FTP over TLS, se il piano Aruba lo richiede/supporta):
FTP_PROTOCOL=ftp
