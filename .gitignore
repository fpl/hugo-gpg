# Output di build Hugo (rigenerato da `hugo`/`make build`, non va versionato)
public/

# Lock file di build, creato e rimosso automaticamente da Hugo
.hugo_build.lock

# Credenziali FTP di pubblicazione (vedi Makefile)
.env.ftp

# Bytecode compilato Python
__pycache__/
*.pyc

# Copie di sicurezza locali create da safe_write_text() quando uno script di
# conversione trova un file modificato a mano (vedi README.md): sono un
# backup ridondante rispetto a git, che ormai è la fonte di verità.
manual-backups/
